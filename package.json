{
  "name": "react-samples-browser",
  "description": "Samples for Ignite UI for React",
  "version": "23.2.915",
  "author": "Infragistics",
  "repository": {
    "type": "git",
    "url": "https://github.com/IgniteUI/igniteui-react-examples"
  },
  "license": "ISC",
  "private": true,
  "type": "module",
  "scripts": {
    "add:sample": "node scripts/add-sample.js",
    "copy:themes": "node scripts/copy-ig-themes.js",
    "predev": "npm run copy:themes",
    "dev": "astro dev --port 4200",
    "prebuild": "npm run copy:themes && npm run generate:code-viewer",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=8192 astro build",
    "preview": "astro preview --port 4200",
    "build:preview": "npm run build && npm run preview",
    "check": "astro check",
    "generate:code-viewer": "node scripts/generate-code-viewer.js",
    "update:ig": "node scripts/update-ig.js",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "file-saver": "^2.0.5",
    "igniteui-dockmanager": "^2.2.1",
    "igniteui-grid-lite": "~0.11.0",
    "igniteui-i18n-resources": "^1.0.5",
    "igniteui-react": "19.9.0",
    "igniteui-react-charts": "19.6.0",
    "igniteui-react-core": "19.6.0",
    "igniteui-react-dashboards": "19.6.0",
    "igniteui-react-data-grids": "19.6.0",
    "igniteui-react-datasources": "19.6.0",
    "igniteui-react-dockmanager": "19.9.0",
    "igniteui-react-excel": "19.6.0",
    "igniteui-react-gauges": "19.6.0",
    "igniteui-react-grids": "19.9.0",
    "igniteui-react-inputs": "19.6.0",
    "igniteui-react-layouts": "19.6.0",
    "igniteui-react-maps": "19.6.0",
    "igniteui-react-spreadsheet": "19.6.0",
    "igniteui-react-spreadsheet-chart-adapter": "19.6.0",
    "igniteui-theming": "^29.0.0",
    "igniteui-webcomponents": "~7.4.1",
    "lit-html": "^3.3.0",
    "marked": "^18.0.14",
    "marked-shiki": "^1.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "~7.3.5",
    "cross-env": "^10.1.0",
    "sass": "^1.97.3",
    "typescript": "^6.0.3"
  }
}
