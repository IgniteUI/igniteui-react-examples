{
  // Type-checks every sample in one program; run through `npm run check:samples`.
  // The add:sample tsconfig settings (see scripts/lib/templates.js), but not
  // strict: the generated samples are not written for strict mode.
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // TypeScript 6 is strict by default.
    "strict": false,
    // Off in TypeScript 5.9, which the samples build with. On, it rejects
    // untyped side-effect entries such as igniteui-react-grids/grids/combined.
    "noUncheckedSideEffectImports": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "samples/*/*/*/src/**/*",
    "scripts/lib/sample-globals.d.ts"
  ]
}
